{
  "name": "traycer",
  "private": true,
  "version": "0.1.0",
  "description": "Passive behavioral biomarker platform for early psychiatric relapse detection",
  "repository": {
    "type": "git",
    "url": "https://github.com/Henrycarto/traycer.git"
  },
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules",
    "sdk:build": "npm run build --workspace=@traycer/sdk",
    "sdk:test": "npm run test --workspace=@traycer/sdk",
    "web:dev": "npm run dev --workspace=@traycer/web",
    "services:up": "docker compose -f infra/docker-compose.yml up --build",
    "services:down": "docker compose -f infra/docker-compose.yml down -v"
  },
  "devDependencies": {
    "rimraf": "^5.0.10",
    "turbo": "^2.1.3",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
