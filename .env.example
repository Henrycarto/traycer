# Copy to .env and fill in. Never commit the filled version.
# Local development values are safe to use as written apart from the secrets,
# which are placeholders and will not work against anything real.

# ---------------------------------------------------------------------------
# Databases
# ---------------------------------------------------------------------------
POSTGRES_DSN=postgresql://traycer:traycer_local@localhost:5432/traycer
TIMESCALE_DSN=postgresql://traycer:traycer_local@localhost:5433/traycer_metrics
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Service to service auth
#
# Symmetric key for internal tokens. In AWS this comes from Secrets Manager
# and is rotated on a schedule. Clinician tokens are asymmetric and are
# verified against the EHR JWKS, so this key never touches them.
# ---------------------------------------------------------------------------
JWT_SIGNING_KEY=replace_me_with_a_32_byte_random_value
JWT_ALGORITHM=HS256
JWT_ISSUER=traycer-platform

# ---------------------------------------------------------------------------
# SMART on FHIR
#
# FHIR_ISSUER is the FHIR base URL of the EHR. The value below is the public
# SMART Health IT sandbox, which is useful for a first run.
# ---------------------------------------------------------------------------
FHIR_ISSUER=https://launch.smarthealthit.org/v/r4/fhir
FHIR_CLIENT_ID=traycer-pulse-local
FHIR_CLIENT_SECRET=
FHIR_REDIRECT_URI=http://localhost:3000/api/fhir/callback
FHIR_SCOPES=launch openid fhirUser profile patient/Patient.read patient/Observation.read offline_access
APP_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Ingest service
#
# Generate the keypair first:
#   python scripts/generate-ingest-keys.py --key-id traycer-ingest-local
#
# That writes the PEM into infra/secrets (gitignored) and prints the public
# JWK to put in the SDK's serverPublicKey. Two ways to supply the private key:
# a path, which is what compose uses, or the PEM inline, which is what ECS
# needs because it injects secrets as environment variables rather than files.
# ---------------------------------------------------------------------------
INGEST_PRIVATE_KEYS={"traycer-ingest-local":"/run/secrets/traycer-ingest-local.pem"}
# INGEST_PRIVATE_KEYS_INLINE={"traycer-ingest-local":"-----BEGIN PRIVATE KEY-----\n..."}
INGEST_PRIVATE_KEY_PASSPHRASE=
INGEST_MAX_BODY_BYTES=1048576

# ---------------------------------------------------------------------------
# Voice service
# ---------------------------------------------------------------------------
OPENSMILE_BINARY=/usr/local/bin/SMILExtract
OPENSMILE_CONFIG=/opt/opensmile/config/egemaps/v02/eGeMAPSv02.conf
OPENSMILE_TIMEOUT_SECONDS=20
VOICE_MAX_SAMPLE_SECONDS=30

# ---------------------------------------------------------------------------
# Scoring service
# ---------------------------------------------------------------------------
BASELINE_WINDOW_DAYS=14
# Private index carrying traycer-relapse-model and traycer-coefficients.
# Leave empty in the public build. The service runs on placeholder
# coefficients and reports that it is doing so.
PRIVATE_INDEX_URL=

# ---------------------------------------------------------------------------
# Push notifications
#
# FCM_DRY_RUN builds and validates every message without sending it. Keep it
# on outside production.
# ---------------------------------------------------------------------------
FCM_PROJECT_ID=traycer-local
FCM_CREDENTIALS_PATH=/run/secrets/fcm.json
FCM_DRY_RUN=true

# ---------------------------------------------------------------------------
# Dashboard
# ---------------------------------------------------------------------------
NEXT_PUBLIC_PULSE_API_URL=http://localhost:8080
PULSE_API_INTERNAL_URL=http://localhost:8080
SCORING_API_INTERNAL_URL=http://localhost:8082
VOICE_API_INTERNAL_URL=http://localhost:8081
# Serves generated data and shows a banner saying so. Set to false once the
# services are running.
TRAYCER_DEMO_MODE=true
