# Agent tooling

# Environment
.env
.env.*
!.env.example

# Node
node_modules/
dist/
.next/
.turbo/
*.tsbuildinfo
coverage/
npm-debug.log*
yarn-error.log*

# Python
__pycache__/
*.pyc
*.pyo
venv/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Ingest private keys. The public half is safe to distribute with the SDK,
# the private half decrypts every batch that has ever been uploaded.
infra/secrets/*
!infra/secrets/README.md
*.pem
*.key
*.p8

# Model artifacts. The relapse prediction model and its weights stay private.
*.onnx
*.pkl
*.pt
*.h5
models/

# Terraform state holds live infrastructure identifiers
*.tfstate
*.tfstate.*
.terraform/
*.tfvars
!*.tfvars.example

# Voice service scratch space. Audio never persists past a request.
services/voice/tmp/
*.wav
*.flac

# OS
.DS_Store
Thumbs.db
.vercel
